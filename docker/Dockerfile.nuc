# syntax=docker/dockerfile:1.4
# Dockerfile.prod.local - Optimized for lower memory usage
#
# Key optimizations:
# 1. Use --webpack flag to disable Turbopack (Next.js 16 uses Turbopack by default)
# 2. BuildKit cache mounts for .next/cache - enables incremental builds
# 3. Separate RUN commands - allows memory to be freed between steps
# 4. ESLint disabled via next.config.ts (eslint.ignoreDuringBuilds)
#
# Build in an isolated builder with at least 6GB RAM and additional swap.
# See: https://nextjs.org/docs/app/guides/memory-usage

FROM node:24-bookworm-slim@sha256:c86ecead9e55a5210ac1727de38a4ca840bf03dcaf34dc9749addbf383b1920c AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates git python3 make g++ && rm -rf /var/lib/apt/lists/*
RUN npm install -g pnpm@11.19.0 --ignore-scripts

# Docker build layers are non-interactive; let pnpm handle module purges without a TTY.
ENV CI=true

# Copy lockfiles/workspace manifests for better caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc* ./
COPY patches ./patches
COPY apps/web/package.json apps/web/package.json
# Lockfile plumbing only; Electron and the unsubscribe worker are not installed.
COPY apps/desktop/package.json apps/desktop/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY apps/unsubscribe-worker/package.json apps/unsubscribe-worker/package.json
COPY apps/image-proxy/package.json apps/image-proxy/package.json
COPY apps/image-proxy-aws/package.json apps/image-proxy-aws/package.json
COPY packages/api/package.json packages/api/package.json
COPY packages/cli/package.json packages/cli/package.json
COPY packages/email-editor/package.json packages/email-editor/package.json
COPY packages/mail-core/package.json packages/mail-core/package.json
COPY packages/mail-sqlite/package.json packages/mail-sqlite/package.json
COPY packages/mail-react/package.json packages/mail-react/package.json
COPY packages/mail-ui/package.json packages/mail-ui/package.json
COPY packages/image-proxy/package.json packages/image-proxy/package.json
COPY packages/network/package.json packages/network/package.json
COPY packages/loops/package.json packages/loops/package.json
COPY packages/transactional-email/package.json packages/transactional-email/package.json
COPY packages/scheduling/package.json packages/scheduling/package.json
COPY packages/tinybird/package.json packages/tinybird/package.json
COPY packages/tinybird-ai-analytics/package.json packages/tinybird-ai-analytics/package.json
COPY packages/tsconfig/package.json packages/tsconfig/package.json

# Copy Prisma schema file needed for postinstall script
COPY apps/web/prisma/schema.prisma apps/web/prisma/schema.prisma
# Copy postinstall script
COPY clone-marketing.sh clone-marketing.sh
COPY scripts/pnpm-install-without-desktop.sh scripts/pnpm-install-without-desktop.sh

# Keep runtime dependency links inside the image, independent of the build cache.
RUN sed -i 's/enableGlobalVirtualStore: true/enableGlobalVirtualStore: false/' pnpm-workspace.yaml

# Install deps with BuildKit cache for pnpm store. Skip @inboxzero/desktop so
# the image does not download Electron.
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    chmod +x scripts/pnpm-install-without-desktop.sh \
 && ./scripts/pnpm-install-without-desktop.sh --frozen-lockfile --shamefully-hoist

# Copy the full repo
COPY . .
RUN sed -i 's/enableGlobalVirtualStore: true/enableGlobalVirtualStore: false/' pnpm-workspace.yaml

# === Build environment ===
ENV NODE_ENV=production
ENV DOCKER_BUILD=true

# Standalone output for Docker deployment
ENV NEXT_PRIVATE_STANDALONE=true

# Bound the webpack heap while leaving room for native allocations.
ENV NODE_OPTIONS=--max_old_space_size=6144

# Feature flag placeholders
ARG NEXT_PUBLIC_BASE_URL="http://NEXT_PUBLIC_BASE_URL_PLACEHOLDER"
ENV NEXT_PUBLIC_BASE_URL=${NEXT_PUBLIC_BASE_URL}
ARG NEXT_PUBLIC_BYPASS_PREMIUM_CHECKS="NEXT_PUBLIC_BYPASS_PREMIUM_CHECKS_PLACEHOLDER"
ENV NEXT_PUBLIC_BYPASS_PREMIUM_CHECKS=${NEXT_PUBLIC_BYPASS_PREMIUM_CHECKS}
ARG NEXT_PUBLIC_EMAIL_SEND_ENABLED="NEXT_PUBLIC_EMAIL_SEND_ENABLED_PLACEHOLDER"
ENV NEXT_PUBLIC_EMAIL_SEND_ENABLED=${NEXT_PUBLIC_EMAIL_SEND_ENABLED}
ARG NEXT_PUBLIC_SELF_HOSTED_LOGIN_FOOTER_TEXT="NEXT_PUBLIC_SELF_HOSTED_LOGIN_FOOTER_TEXT_PLACEHOLDER"
ENV NEXT_PUBLIC_SELF_HOSTED_LOGIN_FOOTER_TEXT=${NEXT_PUBLIC_SELF_HOSTED_LOGIN_FOOTER_TEXT}
ARG NEXT_PUBLIC_CLEANER_ENABLED="NEXT_PUBLIC_CLEANER_ENABLED_PLACEHOLDER"
ENV NEXT_PUBLIC_CLEANER_ENABLED=${NEXT_PUBLIC_CLEANER_ENABLED}
ARG NEXT_PUBLIC_AUTO_DRAFT_DISABLED="NEXT_PUBLIC_AUTO_DRAFT_DISABLED_PLACEHOLDER"
ENV NEXT_PUBLIC_AUTO_DRAFT_DISABLED=${NEXT_PUBLIC_AUTO_DRAFT_DISABLED}
ARG NEXT_PUBLIC_MEETING_BRIEFS_ENABLED="NEXT_PUBLIC_MEETING_BRIEFS_ENABLED_PLACEHOLDER"
ENV NEXT_PUBLIC_MEETING_BRIEFS_ENABLED=${NEXT_PUBLIC_MEETING_BRIEFS_ENABLED}
ARG NEXT_PUBLIC_INTEGRATIONS_ENABLED="NEXT_PUBLIC_INTEGRATIONS_ENABLED_PLACEHOLDER"
ENV NEXT_PUBLIC_INTEGRATIONS_ENABLED=${NEXT_PUBLIC_INTEGRATIONS_ENABLED}
ARG NEXT_PUBLIC_BOOKING_LINKS_ENABLED="NEXT_PUBLIC_BOOKING_LINKS_ENABLED_PLACEHOLDER"
ENV NEXT_PUBLIC_BOOKING_LINKS_ENABLED=${NEXT_PUBLIC_BOOKING_LINKS_ENABLED}
ARG NEXT_PUBLIC_SMART_FILING_ENABLED="NEXT_PUBLIC_SMART_FILING_ENABLED_PLACEHOLDER"
ENV NEXT_PUBLIC_SMART_FILING_ENABLED=${NEXT_PUBLIC_SMART_FILING_ENABLED}
ARG NEXT_PUBLIC_DIGEST_ENABLED="NEXT_PUBLIC_DIGEST_ENABLED_PLACEHOLDER"
ENV NEXT_PUBLIC_DIGEST_ENABLED=${NEXT_PUBLIC_DIGEST_ENABLED}
ARG NEXT_PUBLIC_WEBHOOK_ACTION_ENABLED="NEXT_PUBLIC_WEBHOOK_ACTION_ENABLED_PLACEHOLDER"
ENV NEXT_PUBLIC_WEBHOOK_ACTION_ENABLED=${NEXT_PUBLIC_WEBHOOK_ACTION_ENABLED}
ARG NEXT_PUBLIC_EXTERNAL_API_ENABLED="NEXT_PUBLIC_EXTERNAL_API_ENABLED_PLACEHOLDER"
ENV NEXT_PUBLIC_EXTERNAL_API_ENABLED=${NEXT_PUBLIC_EXTERNAL_API_ENABLED}
ARG NEXT_PUBLIC_AI_MODEL_SETTINGS_DISABLED="NEXT_PUBLIC_AI_MODEL_SETTINGS_DISABLED_PLACEHOLDER"
ENV NEXT_PUBLIC_AI_MODEL_SETTINGS_DISABLED=${NEXT_PUBLIC_AI_MODEL_SETTINGS_DISABLED}

# Dummy envs for build (real values injected at runtime)
ENV DATABASE_URL="postgresql://dummy:dummy@dummy:5432/dummy?schema=public"
ENV DIRECT_URL="postgresql://dummy:dummy@dummy:5432/dummy?schema=public"
ENV AUTH_SECRET="dummy_secret_for_build_only_32chars!"
ENV BETTER_AUTH_SECRET="dummy_secret_for_build_only_32chars!"
ENV GOOGLE_CLIENT_ID="dummy_id_for_build_only"
ENV GOOGLE_CLIENT_SECRET="dummy_secret_for_build_only"
ENV EMAIL_ENCRYPT_SECRET="dummy_encrypt_secret_for_build_only"
ENV EMAIL_ENCRYPT_SALT="dummy_encrypt_salt_for_build_only"
ENV GOOGLE_PUBSUB_TOPIC_NAME="dummy_topic_for_build_only"
ENV GOOGLE_PUBSUB_VERIFICATION_TOKEN="dummy_pubsub_token_for_build"
ENV DEFAULT_LLMS="anthropic:claude-sonnet-4-6"
ENV INTERNAL_API_KEY="dummy_apikey_for_build_only"
ENV API_KEY_SALT="dummy_salt_for_build_only"
ENV REDIS_HTTP_URL="http://dummy-redis-for-build:6379"
ENV REDIS_HTTP_TOKEN="dummy_redis_token_for_build"
ENV REDIS_URL="redis://dummy:dummy@dummy:6379"
ENV QSTASH_TOKEN="dummy_qstash_token_for_build"
ENV QSTASH_CURRENT_SIGNING_KEY="dummy_qstash_curr_key_for_build"
ENV QSTASH_NEXT_SIGNING_KEY="dummy_qstash_next_key_for_build"

# Step 1: Generate Prisma client (separate step = memory freed after)
RUN npx prisma generate --schema=apps/web/prisma/schema.prisma

# Step 2: Build Next.js with webpack (not Turbopack) for lower memory usage
# --webpack: Use webpack/SWC instead of Turbopack (Next.js 16 default)
# Cache mount persists between builds for incremental compilation
RUN --mount=type=cache,target=/app/apps/web/.next/cache \
    cd apps/web && \
    node scripts/spam/build-native.mjs && \
    node scripts/build-mcp-app.mjs && \
    ../../node_modules/.bin/next build --webpack && \
    ../../node_modules/.bin/serwist build serwist.config.mjs

# === Production image ===
FROM node:24-bookworm-slim@sha256:c86ecead9e55a5210ac1727de38a4ca840bf03dcaf34dc9749addbf383b1920c
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates bubblewrap procps && rm -rf /var/lib/apt/lists/* && groupadd -g 10001 inboxzero && useradd -u 10001 -g inboxzero -M inboxzero
COPY --from=builder /app /app
RUN cp -a /app/apps/web/.next/static /app/apps/web/.next/standalone/apps/web/.next/static && cp -a /app/apps/web/public /app/apps/web/.next/standalone/apps/web/public && rm -rf /app/apps/web/.next/cache && mkdir -p /app/apps/web/.next/standalone/apps/web/.next/cache
WORKDIR /app/apps/web
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
USER 10001:10001
CMD ["node","/app/apps/web/.next/standalone/apps/web/server.js"]
